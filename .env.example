# Copy to .env and fill in. Never commit real values.

# ---------- backend (Tylin) ----------
# Stripe: TEST MODE ONLY. A live key must be refused at startup.
STRIPE_SECRET_KEY=

# Notion API version 2025-09-03 (data sources)
NOTION_TOKEN=
NOTION_VERSION=2025-09-03
NOTION_DATA_SOURCE_ID=

# Airtable personal access token (scopes: data.records:read, data.records:write, schema.bases:read)
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=

# Slack app, Socket Mode
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_APPROVAL_CHANNEL=

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=

# Postgres (Supabase in the deployed demo, docker-compose locally)
DATABASE_URL=

# Ed25519 signing key for the ledger head (hex). Public key is derived and served.
PQ_SIGNING_KEY=

# Fault injection scenario name for evals and the judge sandbox (empty in normal runs)
PQ_FAULT=

# Comma separated origins allowed by CORS (the Vercel URL and localhost)
PQ_ALLOWED_ORIGINS=http://localhost:3000

# Operator token for the UI approval fallback endpoint
PQ_OPERATOR_TOKEN=

# Judge sandbox limits
PQ_SANDBOX_RUNS_PER_MINUTE=

# ---------- web (Stephen) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Not set by hand. The deploy command stamps the commit: vercel --prod --build-env NEXT_PUBLIC_BUILD_SHA=$(git rev-parse HEAD)
# NEXT_PUBLIC_BUILD_SHA=
